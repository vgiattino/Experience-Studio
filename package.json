{
  "name": "opus-experience-studio",
  "version": "0.1.0",
  "description": "AI-native experience platform for Opus EDM \u2014 Milestone 1 runtime proof of concept",
  "private": true,
  "scripts": {
    "start": "ng serve viewer",
    "build": "ng build viewer && ng build studio",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "validate": "node tools/validate-metadata.mjs",
    "verify": "npm run validate && npm run test -- --watch=false && npm run build",
    "studio": "ng serve studio",
    "build:viewer": "ng build viewer",
    "build:studio": "ng build studio"
  },
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
