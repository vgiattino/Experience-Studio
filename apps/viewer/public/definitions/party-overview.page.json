  "actions": {
    "set-issued-query": {
      "id": "set-issued-query",
      "kind": "setFilter",
      "label": "Search",
      "channel": "issued-query",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace"
    },
    "set-issued-class": {
      "id": "set-issued-class",
      "kind": "setFilter",
      "label": "Filter by asset class",
      "channel": "issued-class",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace",
      "enabled": {
        "$expr": "$event.channel == 'issued-class'"
      }
    },
    "filter-issued-class": {
      "id": "filter-issued-class",
      "kind": "setFilter",
      "label": "Filter by asset class",
      "channel": "issued-class",
      "value": {
        "$context": "$event.x"
      },
      "mode": "toggle"
    },
    "set-focused-issue": {
      "id": "set-focused-issue",
      "kind": "setSelection",
      "channel": "focused-issue",
      "value": {
        "$context": "$event.security-id"
      }
    },
    "clear-issued-filters": {
      "id": "clear-issued-filters",
      "kind": "clearFilters",
      "label": "Clear",
      "channels": [
        "issued-query",
        "issued-class"
      ]
    },
    "refresh-page": {
      "id": "refresh-page",
      "kind": "refresh",
      "label": "Refresh",
      "icon": "refresh",
      "bypassCache": true
    },
    "drill-to-security": {
      "id": "drill-to-security",
      "kind": "drilldown",
      "label": "Open security",
      "entity": "securities.security",
      "key": {
        "security-id": {
          "$context": "$event.security-id"
        }
      },
      "carryContext": true,
      "openIn": "self"
    },
    "drill-to-parent": {
      "id": "drill-to-parent",
      "kind": "drilldown",
      "label": "Parent party",
      "entity": "parties.party",
      "key": {
        "party-id": {
          "$expr": "$data.party-header.parent-party-id"
        }
      },
      "carryContext": true,
      "openIn": "self",
      "enabled": {
        "$expr": "$data.party-header.parent-party-id != null"
      }
    },
    "back-to-master": {
      "id": "back-to-master",
      "kind": "navigate",
      "label": "Security master",
      "target": {
        "page": "security-master-dashboard"
      },
      "carryContext": true
    },
    "go-to-exceptions": {
      "id": "go-to-exceptions",
      "kind": "navigate",
      "label": "Exception management",
      "target": {
        "page": "exception-management"
      },
      "carryContext": true
    },
    "open-lei-record": {
      "id": "open-lei-record",
      "kind": "openUrl",
      "label": "GLEIF record",
      "icon": "external",
      "urlTemplate": "https://search.gleif.org/#/record/{lei}",
      "params": {
        "lei": {
          "$expr": "$data.party-header.lei"
        }
      },
      "target": "newTab",
      "description": "The public LEI register entry for this entity. External, so it opens in a new tab and is not treated as navigation within the experience.",
      "enabled": {
        "$expr": "$data.party-header.lei != null"
      }
    },
    "export-issued": {
      "id": "export-issued",
      "kind": "export",
      "label": "Export",
      "icon": "download",
      "dataSource": "issued-securities",
      "scope": "all",
      "format": "csv",
      "includeMetadata": true,
      "auditProfile": "elevated",
      "security": {
        "requiredCapabilities": [
          "export.data"
        ]
      },
      "confirm": {
        "message": "Export this party\u2019s issuance? The export carries your entitlements and is recorded in the audit trail.",
        "requiresReason": true
      }
    }
  },
  "navigation": {
    "breadcrumbs": {
      "mode": "auto"
    },
    "pageActions": [
      "drill-to-parent",
      "open-lei-record",
      "back-to-master",
      "go-to-exceptions",
      "refresh-page"
    ],
    "relatedLinks": [
