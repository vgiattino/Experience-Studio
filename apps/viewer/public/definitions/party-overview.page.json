        {
          "kind": "container",
          "id": "instrument-panel",
          "placement": {
            "colStart": 1,
            "colSpan": 12
          },
          "container": {
            "type": "panel",
            "title": "Instrument detail",
            "variant": "bordered",
            "subtitle": "One tab per instrument this party issued, generated from the data and capped at twelve.",
            "children": [
              {
                "kind": "container",
                "id": "instrument-tabs-container",
                "placement": {
                  "colStart": 1,
                  "colSpan": 12
                },
                "container": {
                  "type": "tabs",
                  "variant": "pill",
                  "overflow": "menu",
                  "selectedTabChannel": "active-instrument",
                  "deferContent": true,
                  "keepAliveOnSwitch": true,
                  "source": {
                    "mode": "dataDriven",
                    "source": "instrument-tabs",
                    "idField": "security-id",
                    "labelField": "name",
                    "orderField": "name",
                    "maxTabs": 12,
                    "emptyBehaviour": "showEmptyState",
                    "template": [
                      {
                        "kind": "widget",
                        "id": "t-instrument-exceptions",
                        "component": "instrument-exceptions-table",
                        "placement": {
                          "colStart": 1,
                          "colSpan": 12
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
