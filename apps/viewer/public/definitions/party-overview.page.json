              "export-issued",
              "refresh-page"
            ],
            "children": [
              {
                "kind": "widget",
                "id": "w-issued-table",
                "component": "issued-table",
                "placement": {
                  "colStart": 1,
                  "colSpan": 12
                }
              }
            ]
          }
