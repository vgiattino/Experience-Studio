{
  "schemaVersion": "1.0",
  "id": "security-master-dashboard",
  "name": "Security Master Dashboard",
  "description": "Coverage, approval backlog and vendor agreement across the security master, with search and drill-through to any instrument.",
  "kind": "dashboard",
  "tags": [
    "template",
    "securities",
    "master-data",
    "edm"
  ],
  "parameters": {
    "as-of": {
      "label": "As Of",
      "dataType": "date",
      "scope": "experience",
      "syncToUrl": true,
      "default": {
        "$expr": "today()"
      },
      "description": "Business date the figures are reported for."
    }
  },
  "filters": {
    "query": {
      "label": "Search",
      "dataType": "string",
      "boundToAttribute": "securities.security.name",
      "syncToUrl": true,
      "clearable": true,
      "description": "Free-text search over the security name. Written by the filter bar through a setFilter action."
    },
    "asset-class": {
      "label": "Asset Class",
      "dataType": "enum",
      "multiValued": true,
      "boundToAttribute": "securities.security.asset-class",
      "syncToUrl": true,
      "clearable": true,
      "description": "Set from the facet bar or by clicking a chart segment — both write the same channel, so the two stay consistent."
    },
    "review-status": {
      "label": "Review Status",
      "dataType": "enum",
      "multiValued": true,
      "boundToAttribute": "securities.security.review-status",
      "syncToUrl": true,
      "clearable": true
    },
    "active-class": {
      "label": "Active Asset Class",
      "dataType": "enum",
      "boundToAttribute": "securities.security.asset-class",
      "syncToUrl": true,
      "clearable": false,
      "description": "Holds the active data-driven tab. Declaring it as a channel is what makes the generated tabs deep-linkable and readable by the tab template’s own data source."
    }
  },
  "selections": {
    "focused-security": {
      "label": "Focused Security",
      "mode": "single",
      "entity": "securities.security",
      "keyFields": [
        "security-id"
      ]
    }
  },
  "dataSources": {
    "total-securities": {
      "id": "total-securities",
      "name": "Securities",
      "entity": "securities.security",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "security-count",
            "aggregation": "count",
            "alias": "total"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "status",
            "operator": "in",
            "value": [
              "ACTIVE",
              "PENDING",
              "MATURED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "review-status",
            "operator": "in",
            "value": {
              "$filter": "review-status"
            }
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 300
    },
    "pending-review": {
      "id": "pending-review",
      "name": "Pending Review",
      "entity": "securities.security",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "pending-review-count",
            "aggregation": "count",
            "alias": "pending"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "status",
            "operator": "in",
            "value": [
              "ACTIVE",
              "PENDING",
              "MATURED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "review-status",
            "operator": "in",
            "value": [
              "PENDING",
              "ESCALATED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 300
    },
    "vendor-disagreements": {
      "id": "vendor-disagreements",
      "name": "Vendor Disagreements",
      "entity": "securities.source-value",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "mismatch-count",
            "aggregation": "count",
            "alias": "mismatches"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "match-status",
            "operator": "in",
            "value": [
              "MISMATCH"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 300
    },
    "open-exceptions": {
      "id": "open-exceptions",
      "name": "Open Exceptions",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "exception-count",
            "aggregation": "count",
            "alias": "open"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 120
    },
    "by-asset-class": {
      "id": "by-asset-class",
      "name": "Securities by Asset Class",
      "entity": "securities.security",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "security-count",
            "aggregation": "count",
            "alias": "count"
          }
        ],
        "dimensions": [
          {
            "attribute": "asset-class",
            "alias": "asset-class",
            "label": "Asset Class"
          },
          {
            "attribute": "review-status",
            "alias": "review-status",
            "label": "Review Status"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "status",
            "operator": "in",
            "value": [
              "ACTIVE",
              "PENDING",
              "MATURED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          }
        ]
      },
      "sort": [
        {
          "field": "count",
          "direction": "desc"
        }
      ],
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 300
    },
    "class-tabs": {
      "id": "class-tabs",
      "name": "Asset Classes Present",
      "entity": "securities.security",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "security-count",
            "aggregation": "count",
            "alias": "count"
          }
        ],
        "dimensions": [
          {
            "attribute": "asset-class",
            "alias": "asset-class",
            "label": "Asset Class"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "status",
            "operator": "in",
            "value": [
              "ACTIVE",
              "PENDING",
              "MATURED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          }
        ]
      },
      "sort": [
        {
          "field": "count",
          "direction": "desc"
        }
      ],
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 300
    },
    "class-securities": {
      "id": "class-securities",
      "name": "Securities in Class",
      "entity": "securities.security",
      "kind": "list",
      "select": {
        "attributes": [
          {
            "attribute": "name",
            "alias": "name",
            "label": "Security Name"
          },
          {
            "attribute": "isin",
            "alias": "isin",
            "label": "ISIN"
          },
          {
            "attribute": "issuer-name",
            "alias": "issuer-name",
            "label": "Issuer"
          },
          {
            "attribute": "sector",
            "alias": "sector",
            "label": "Sector"
          },
          {
            "attribute": "currency",
            "alias": "currency",
            "label": "Ccy"
          },
          {
            "attribute": "review-status",
            "alias": "review-status",
            "label": "Review"
          },
          {
            "attribute": "created-at",
            "alias": "created-at",
            "label": "Created"
          },
          {
            "attribute": "security-id",
            "alias": "security-id"
          },
          {
            "attribute": "issuer-id",
            "alias": "issuer-id"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "status",
            "operator": "in",
            "value": [
              "ACTIVE",
              "PENDING",
              "MATURED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "asset-class",
            "operator": "eq",
            "value": {
              "$filter": "active-class"
            }
          },
          {
            "target": "name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "review-status",
            "operator": "in",
            "value": {
              "$filter": "review-status"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "created-at",
          "direction": "desc"
        }
      ],
      "paging": {
        "mode": "offset",
        "pageSize": 25,
        "maxRows": 2000
      },
      "loadPolicy": "deferred",
      "cacheTtlHintSeconds": 120
    },
    "recent-securities": {
      "id": "recent-securities",
      "name": "Recently Added",
      "entity": "securities.security",
      "kind": "list",
      "select": {
        "attributes": [
          {
            "attribute": "name",
            "alias": "name",
            "label": "Security Name"
          },
          {
            "attribute": "isin",
            "alias": "isin",
            "label": "ISIN"
          },
          {
            "attribute": "sedol",
            "alias": "sedol",
            "label": "SEDOL"
          },
          {
            "attribute": "asset-class",
            "alias": "asset-class",
            "label": "Asset Class"
          },
          {
            "attribute": "issuer-name",
            "alias": "issuer-name",
            "label": "Issuer"
          },
          {
            "attribute": "country-of-risk",
            "alias": "country-of-risk",
            "label": "Risk Ctry"
          },
          {
            "attribute": "review-status",
            "alias": "review-status",
            "label": "Review"
          },
          {
            "attribute": "created-at",
            "alias": "created-at",
            "label": "Created"
          },
          {
            "attribute": "security-id",
            "alias": "security-id"
          },
          {
            "attribute": "issuer-id",
            "alias": "issuer-id"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "status",
            "operator": "in",
            "value": [
              "ACTIVE",
              "PENDING",
              "MATURED"
            ],
            "skipWhenEmpty": false
          },
          {
            "target": "name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "review-status",
            "operator": "in",
            "value": {
              "$filter": "review-status"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "created-at",
          "direction": "desc"
        }
      ],
      "paging": {
        "mode": "offset",
        "pageSize": 25,
        "maxRows": 5000
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 120
    }
  },
  "components": {
    "page-intro": {
      "id": "page-intro",
      "type": "content.text",
      "typeVersion": "1.0.0",
      "title": "Security master coverage",
      "config": {
        "variant": "body",
        "body": "Reporting for {asOf}. {total} instruments in scope, {pending} awaiting steward approval and {mismatches} vendor disagreements outstanding. Search or pick a facet to narrow every widget at once.",
        "tokens": {
          "asOf": {
            "$expr": "$params.as-of"
          },
          "total": {
            "$expr": "$data.total-securities.total ?? 0"
          },
          "pending": {
            "$expr": "$data.pending-review.pending ?? 0"
          },
          "mismatches": {
            "$expr": "$data.vendor-disagreements.mismatches ?? 0"
          }
        }
      }
    },
    "search-bar": {
      "id": "search-bar",
      "type": "input.filter-bar",
      "typeVersion": "1.0.0",
      "title": "Find a security",
      "config": {
        "searchChannel": "query",
        "searchPlaceholder": "Search by security name",
        "debounceMs": 250,
        "facets": [
          {
            "channel": "asset-class",
            "label": "Asset Class",
            "multi": true,
            "options": [
              {
                "value": "EQUITY",
                "label": "Equity"
              },
              {
                "value": "BOND",
                "label": "Bond"
              },
              {
                "value": "FUND",
                "label": "Fund"
              },
              {
                "value": "DERIVATIVE",
                "label": "Derivative"
              }
            ]
          },
          {
            "channel": "review-status",
            "label": "Review",
            "options": [
              {
                "value": "APPROVED",
                "label": "Approved"
              },
              {
                "value": "PENDING",
                "label": "Pending Review"
              },
              {
                "value": "ESCALATED",
                "label": "Escalated"
              }
            ]
          }
        ],
        "showClearAll": true,
        "summary": "Search and facets write filter channels; every widget that reads one re-queries, and the rest do not."
      },
      "eventActions": {
        "searchChanged": "set-query",
        "facetChanged": [
          "set-asset-class-facet",
          "set-review-facet"
        ],
        "cleared": "clear-filters"
      },
      "writesTo": {
        "filters": [
          "query",
          "asset-class",
          "review-status"
        ]
      }
    },
    "kpi-total": {
      "id": "kpi-total",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Instruments in Scope",
      "dataSource": "total-securities",
      "config": {
        "size": "md",
        "showThresholdBand": false
      },
      "bindings": {
        "value": {
          "field": "total",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Securities matching the current search and facets."
    },
    "kpi-pending": {
      "id": "kpi-pending",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Pending Review",
      "dataSource": "pending-review",
      "config": {
        "size": "md",
        "showThresholdBand": true
      },
      "bindings": {
        "value": {
          "field": "pending",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Not yet approved by a data steward."
    },
    "kpi-mismatch": {
      "id": "kpi-mismatch",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Vendor Disagreements",
      "dataSource": "vendor-disagreements",
      "config": {
        "size": "md",
        "showThresholdBand": true
      },
      "bindings": {
        "value": {
          "field": "mismatches",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Contributions whose value differs from the published golden copy."
    },
    "kpi-exceptions": {
      "id": "kpi-exceptions",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Open Exceptions",
      "dataSource": "open-exceptions",
      "config": {
        "size": "md",
        "showThresholdBand": true
      },
      "bindings": {
        "value": {
          "field": "open",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Unresolved data quality breaks across the master."
    },
    "class-chart": {
      "id": "class-chart",
      "type": "analytics.chart",
      "typeVersion": "1.0.0",
      "title": "Coverage by asset class and review state",
      "description": "Click a segment to filter the whole page by asset class.",
      "dataSource": "by-asset-class",
      "config": {
        "mark": "bar",
        "stacking": "stacked",
        "legend": {
          "position": "bottom"
        },
        "gridlines": true
      },
      "encodings": [
        {
          "channel": "x",
          "binding": {
            "field": "asset-class",
            "label": "Asset Class"
          },
          "axis": {
            "title": "Asset Class",
            "gridlines": false
          }
        },
        {
          "channel": "y",
          "binding": {
            "field": "count",
            "label": "Securities",
            "format": {
              "style": "integer"
            }
          },
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "Securities"
          }
        },
        {
          "channel": "series",
          "binding": {
            "field": "review-status",
            "label": "Review Status"
          }
        }
      ],
      "eventActions": {
        "segmentActivated": "filter-by-class"
      }
    },
    "class-table": {
      "id": "class-table",
      "type": "data.table",
      "typeVersion": "1.0.0",
      "title": "Instruments in this asset class",
      "description": "One table definition serves every generated tab; the active tab is a filter channel it reads.",
      "dataSource": "class-securities",
      "config": {
        "density": "compact",
        "maxHeight": "360px",
        "zebra": true
      },
      "bindings": {
        "columns": [
          {
            "field": "name",
            "label": "Security Name",
            "renderAs": "link"
          },
          {
            "field": "isin",
            "label": "ISIN"
          },
          {
            "field": "issuer-name",
            "label": "Issuer"
          },
          {
            "field": "sector",
            "label": "Sector"
          },
          {
            "field": "currency",
            "label": "Ccy"
          },
          {
            "field": "review-status",
            "label": "Review"
          },
          {
            "field": "created-at",
            "label": "Created",
            "format": {
              "style": "datetime"
            }
          },
          {
            "field": "security-id",
            "hidden": true
          },
          {
            "field": "issuer-id",
            "hidden": true
          }
        ]
      },
      "eventActions": {
        "rowActivated": "drill-to-security"
      },
      "stateOverrides": {
        "empty": {
          "title": "Nothing in this class",
          "message": "No instruments match the current search in this asset class."
        }
      }
    },
    "recent-table": {
      "id": "recent-table",
      "type": "data.table",
      "typeVersion": "1.0.0",
      "title": "Recently added instruments",
      "dataSource": "recent-securities",
      "config": {
        "density": "compact",
        "maxHeight": "440px",
        "zebra": true,
        "selectionMode": "single",
        "showRowCount": true
      },
      "bindings": {
        "columns": [
          {
            "field": "name",
            "label": "Security Name",
            "renderAs": "link"
          },
          {
            "field": "isin",
            "label": "ISIN"
          },
          {
            "field": "sedol",
            "label": "SEDOL"
          },
          {
            "field": "asset-class",
            "label": "Asset Class"
          },
          {
            "field": "issuer-name",
            "label": "Issuer",
            "renderAs": "link",
            "action": "drill-to-issuer"
          },
          {
            "field": "country-of-risk",
            "label": "Risk Ctry"
          },
          {
            "field": "review-status",
            "label": "Review"
          },
          {
            "field": "created-at",
            "label": "Created",
            "format": {
              "style": "datetime"
            }
          },
          {
            "field": "security-id",
            "hidden": true
          },
          {
            "field": "issuer-id",
            "hidden": true
          }
        ]
      },
      "eventActions": {
        "rowActivated": "drill-to-security",
        "selectionChanged": "set-focused-security"
      },
      "stateOverrides": {
        "empty": {
          "title": "No instruments match",
          "message": "Clear the search or widen the facets."
        }
      }
    }
  },
  "layout": {
    "kind": "container",
    "id": "root",
    "container": {
      "type": "grid",
      "columns": 12,
      "gap": "lg",
      "children": [
        {
          "kind": "widget",
          "id": "w-page-intro",
          "component": "page-intro",
          "placement": {
            "colStart": 1,
            "colSpan": 12
          }
        },
        {
          "kind": "widget",
          "id": "w-search-bar",
          "component": "search-bar",
          "placement": {
            "colStart": 1,
            "colSpan": 12
          }
        },
        {
          "kind": "container",
          "id": "kpi-row",
          "placement": {
            "colStart": 1,
            "colSpan": 12
          },
          "container": {
            "type": "stack",
            "direction": "row",
            "wrap": true,
            "gap": "md",
            "directionByBreakpoint": {
              "xs": "column"
            },
            "children": [
              {
                "kind": "widget",
                "id": "w-kpi-total",
                "component": "kpi-total",
                "placement": {
                  "colSpan": 12,
                  "breakpoints": {
                    "sm": {
                      "colSpan": 6
                    },
                    "lg": {
                      "colSpan": 3
                    }
                  }
                }
              },
              {
                "kind": "widget",
                "id": "w-kpi-pending",
                "component": "kpi-pending",
                "placement": {
                  "colSpan": 12,
                  "breakpoints": {
                    "sm": {
                      "colSpan": 6
                    },
                    "lg": {
                      "colSpan": 3
                    }
                  }
                }
              },
              {
                "kind": "widget",
                "id": "w-kpi-mismatch",
                "component": "kpi-mismatch",
                "placement": {
                  "colSpan": 12,
                  "breakpoints": {
                    "sm": {
                      "colSpan": 6
                    },
                    "lg": {
                      "colSpan": 3
                    }
                  }
                }
              },
              {
                "kind": "widget",
                "id": "w-kpi-exceptions",
                "component": "kpi-exceptions",
                "placement": {
                  "colSpan": 12,
                  "breakpoints": {
                    "sm": {
                      "colSpan": 6
                    },
                    "lg": {
                      "colSpan": 3
