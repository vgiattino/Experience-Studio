                  "colSpan": 12,
                  "breakpoints": {
                    "sm": {
                      "colSpan": 6
                    },
                    "lg": {
                      "colSpan": 3
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "kind": "container",
          "id": "trend-panel",
          "placement": {
            "colStart": 1,
            "colSpan": 12,
            "minHeight": "320px",
            "breakpoints": {
              "xl": {
                "colSpan": 5
              }
            }
          },
          "container": {
            "type": "panel",
            "title": "Detection trend",
            "variant": "bordered",
            "children": [
              {
                "kind": "widget",
                "id": "w-severity-trend",
                "component": "severity-trend",
                "placement": {
                  "colSpan": 12,
