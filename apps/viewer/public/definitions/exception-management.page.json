  "actions": {
    "set-query": {
      "id": "set-query",
      "kind": "setFilter",
      "label": "Search",
      "channel": "query",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace"
    },
    "set-severity-facet": {
      "id": "set-severity-facet",
      "kind": "setFilter",
      "label": "Filter by severity",
      "channel": "severity",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace",
      "enabled": {
        "$expr": "$event.channel == 'severity'"
      }
    },
    "set-status-facet": {
      "id": "set-status-facet",
      "kind": "setFilter",
      "label": "Filter by status",
      "channel": "status",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace",
      "enabled": {
        "$expr": "$event.channel == 'status'"
      }
    },
    "set-class-facet": {
      "id": "set-class-facet",
      "kind": "setFilter",
      "label": "Filter by asset class",
      "channel": "asset-class",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace",
      "enabled": {
        "$expr": "$event.channel == 'asset-class'"
      }
    },
    "filter-by-severity": {
      "id": "filter-by-severity",
      "kind": "setFilter",
      "label": "Filter by severity",
      "channel": "severity",
      "value": {
        "$context": "$event.series"
      },
      "mode": "toggle"
    },
    "set-focused-exception": {
      "id": "set-focused-exception",
      "kind": "setSelection",
      "channel": "focused-exception",
      "value": {
        "$context": "$event.exception-id"
      }
    },
    "clear-filters": {
      "id": "clear-filters",
      "kind": "clearFilters",
      "label": "Clear filters",
      "channels": [
        "query",
        "severity",
        "status",
        "asset-class"
      ]
    },
    "refresh-page": {
      "id": "refresh-page",
      "kind": "refresh",
      "label": "Refresh",
      "icon": "refresh",
      "bypassCache": true
    },
    "raise-threshold": {
      "id": "raise-threshold",
      "kind": "setParameter",
      "label": "Ageing at 24h",
      "parameter": "age-threshold-hours",
      "value": 24,
      "description": "Retunes what counts as ageing. A parameter change re-queries only the sources that read it \u2014 the trend and the queues are untouched."
    },
    "drill-to-security": {
      "id": "drill-to-security",
      "kind": "drilldown",
      "label": "Open security",
      "entity": "securities.security",
      "key": {
        "security-id": {
          "$context": "$event.security-id"
        }
      },
      "carryContext": true,
      "openIn": "self"
    },
    "drill-to-issuer": {
      "id": "drill-to-issuer",
      "kind": "drilldown",
      "label": "Open issuer",
      "entity": "parties.party",
      "key": {
        "party-id": {
          "$context": "$event.issuer-id"
        }
      },
      "carryContext": true,
      "openIn": "self"
    },
    "go-to-master": {
      "id": "go-to-master",
      "kind": "navigate",
      "label": "Security master",
      "target": {
        "page": "security-master-dashboard"
      },
      "carryContext": true
    },
    "export-rule-queue": {
      "id": "export-rule-queue",
      "kind": "export",
      "label": "Export rule",
      "icon": "download",
      "dataSource": "rule-queue",
      "scope": "all",
      "format": "csv",
      "includeMetadata": true,
      "auditProfile": "elevated",
      "security": {
        "requiredCapabilities": [
          "export.data"
        ]
      },
      "confirm": {
        "message": "Export the queue for this rule? The export carries your entitlements and is recorded in the audit trail.",
        "requiresReason": true
      }
    },
    "export-all": {
      "id": "export-all",
      "kind": "export",
      "label": "Export",
      "icon": "download",
      "dataSource": "all-exceptions",
      "scope": "all",
      "format": "csv",
      "includeMetadata": true,
      "auditProfile": "elevated",
      "security": {
        "requiredCapabilities": [
          "export.data"
        ]
      },
      "confirm": {
        "message": "Export the full remediation queue?",
        "requiresReason": true
      }
    }
  },
