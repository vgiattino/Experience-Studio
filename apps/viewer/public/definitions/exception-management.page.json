                  "breakpoints": {
                    "sm": {
                      "colSpan": 6
                    },
                    "lg": {
                      "colSpan": 3
                    }
                  }
                }
              },
              {
                "kind": "widget",
                "id": "w-kpi-oldest",
                "component": "kpi-oldest",
