{
  "schemaVersion": "1.0",
  "id": "exception-management",
  "name": "Exception Management",
  "description": "The data quality remediation queue: what is broken, how badly, how long it has been broken, and which rule broke it.",
  "kind": "workspace",
  "tags": [
    "template",
    "data-quality",
    "remediation",
    "edm"
  ],
  "parameters": {
    "as-of": {
      "label": "As Of",
      "dataType": "date",
      "scope": "experience",
      "syncToUrl": true,
      "default": {
        "$expr": "today()"
      }
    },
    "age-threshold-hours": {
      "label": "Ageing Threshold (hours)",
      "dataType": "integer",
      "scope": "page",
      "syncToUrl": true,
      "default": 48,
      "description": "Breaks older than this count as ageing. A parameter rather than a constant, so a team can tune its own tolerance without a new page."
    }
  },
  "filters": {
    "query": {
      "label": "Search",
      "dataType": "string",
      "boundToAttribute": "dq.exception.security-name",
      "syncToUrl": true,
      "clearable": true,
      "description": "Free-text search over the security the break was raised against."
    },
    "severity": {
      "label": "Severity",
      "dataType": "enum",
      "multiValued": true,
      "boundToAttribute": "dq.exception.severity",
      "syncToUrl": true,
      "clearable": true
    },
    "status": {
      "label": "Status",
      "dataType": "enum",
      "multiValued": true,
      "boundToAttribute": "dq.exception.exception-status",
      "syncToUrl": true,
      "clearable": true
    },
    "asset-class": {
      "label": "Asset Class",
      "dataType": "enum",
      "multiValued": true,
      "boundToAttribute": "dq.exception.asset-class",
      "syncToUrl": true,
      "clearable": true
    },
    "active-rule": {
      "label": "Active Rule",
      "dataType": "string",
      "boundToAttribute": "dq.exception.rule-name",
      "syncToUrl": true,
      "clearable": false,
      "description": "Holds the active rule tab. The per-rule queue reads it, which is how one table serves every generated tab."
    }
  },
  "selections": {
    "focused-exception": {
      "label": "Focused Exception",
      "mode": "single",
      "entity": "dq.exception",
      "keyFields": [
        "exception-id"
      ]
    }
  },
  "dataSources": {
    "open-total": {
      "id": "open-total",
      "name": "Open",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "exception-count",
            "aggregation": "count",
            "alias": "open"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 60
    },
    "high-severity": {
      "id": "high-severity",
      "name": "High Severity",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "exception-count",
            "aggregation": "count",
            "alias": "high"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "severity",
            "operator": "eq",
            "value": "HIGH",
            "skipWhenEmpty": false
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 60
    },
    "ageing": {
      "id": "ageing",
      "name": "Ageing",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "exception-count",
            "aggregation": "count",
            "alias": "ageing"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "age-hours",
            "operator": "gte",
            "value": {
              "$param": "age-threshold-hours"
            },
            "skipWhenEmpty": false
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 60
    },
    "oldest": {
      "id": "oldest",
      "name": "Oldest",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "age-hours",
            "aggregation": "max",
            "alias": "oldest"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 60
    },
    "by-severity": {
      "id": "by-severity",
      "name": "Breaks by Severity",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "exception-count",
            "aggregation": "count",
            "alias": "count"
          }
        ],
        "dimensions": [
          {
            "attribute": "detected-at",
            "alias": "detected-at",
            "label": "Detected",
            "granularity": "day"
          },
          {
            "attribute": "severity",
            "alias": "severity",
            "label": "Severity"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "detected-at",
            "operator": "inLast",
            "value": 14,
            "unit": "day",
            "skipWhenEmpty": false
          }
        ]
      },
      "sort": [
        {
          "field": "detected-at",
          "direction": "asc"
        }
      ],
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 120
    },
    "rule-tabs": {
      "id": "rule-tabs",
      "name": "Failing Rules",
      "entity": "dq.exception",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "exception-count",
            "aggregation": "count",
            "alias": "count"
          }
        ],
        "dimensions": [
          {
            "attribute": "rule-name",
            "alias": "rule-name",
            "label": "Rule"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "sort": [
        {
          "field": "count",
          "direction": "desc"
        }
      ],
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 120
    },
    "rule-queue": {
      "id": "rule-queue",
      "name": "Queue for Rule",
      "entity": "dq.exception",
      "kind": "list",
      "select": {
        "attributes": [
          {
            "attribute": "security-name",
            "alias": "security-name",
            "label": "Security"
          },
          {
            "attribute": "asset-class",
            "alias": "asset-class",
            "label": "Asset Class"
          },
          {
            "attribute": "issuer-name",
            "alias": "issuer-name",
            "label": "Issuer"
          },
          {
            "attribute": "severity",
            "alias": "severity",
            "label": "Severity"
          },
          {
            "attribute": "exception-status",
            "alias": "exception-status",
            "label": "Status"
          },
          {
            "attribute": "age-hours",
            "alias": "age-hours",
            "label": "Age"
          },
          {
            "attribute": "assigned-to",
            "alias": "assigned-to",
            "label": "Assigned To"
          },
          {
            "attribute": "exception-id",
            "alias": "exception-id"
          },
          {
            "attribute": "security-id",
            "alias": "security-id"
          },
          {
            "attribute": "issuer-id",
            "alias": "issuer-id"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          },
          {
            "target": "rule-name",
            "operator": "eq",
            "value": {
              "$filter": "active-rule"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": [
              "OPEN",
              "IN_PROGRESS"
            ],
            "skipWhenEmpty": false
          }
        ]
      },
      "sort": [
        {
          "field": "age-hours",
          "direction": "desc"
        }
      ],
      "paging": {
        "mode": "offset",
        "pageSize": 50,
        "maxRows": 5000
      },
      "loadPolicy": "deferred",
      "cacheTtlHintSeconds": 60
    },
    "all-exceptions": {
      "id": "all-exceptions",
      "name": "All Exceptions",
      "entity": "dq.exception",
      "kind": "list",
      "select": {
        "attributes": [
          {
            "attribute": "security-name",
            "alias": "security-name",
            "label": "Security"
          },
          {
            "attribute": "rule-name",
            "alias": "rule-name",
            "label": "Rule"
          },
          {
            "attribute": "severity",
            "alias": "severity",
            "label": "Severity"
          },
          {
            "attribute": "exception-status",
            "alias": "exception-status",
            "label": "Status"
          },
          {
            "attribute": "age-hours",
            "alias": "age-hours",
            "label": "Age"
          },
          {
            "attribute": "assigned-to",
            "alias": "assigned-to",
            "label": "Assigned To"
          },
          {
            "attribute": "detected-at",
            "alias": "detected-at",
            "label": "Detected"
          },
          {
            "attribute": "exception-id",
            "alias": "exception-id"
          },
          {
            "attribute": "security-id",
            "alias": "security-id"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "security-name",
            "operator": "contains",
            "value": {
              "$filter": "query"
            },
            "caseSensitive": false
          },
          {
            "target": "severity",
            "operator": "in",
            "value": {
              "$filter": "severity"
            }
          },
          {
            "target": "exception-status",
            "operator": "in",
            "value": {
              "$filter": "status"
            }
          },
          {
            "target": "asset-class",
            "operator": "in",
            "value": {
              "$filter": "asset-class"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "age-hours",
          "direction": "desc"
        }
      ],
      "paging": {
        "mode": "offset",
        "pageSize": 50,
        "maxRows": 20000
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 60
    }
  },
  "components": {
    "page-intro": {
      "id": "page-intro",
      "type": "content.text",
      "typeVersion": "1.0.0",
      "title": "Remediation queue",
      "config": {
        "variant": "body",
        "body": "Reporting for {asOf}. {open} breaks outstanding, {high} of them high severity and {ageing} older than {threshold} hours. The oldest has been open {oldest}.",
        "tokens": {
          "asOf": {
            "$expr": "$params.as-of"
          },
          "open": {
            "$expr": "$data.open-total.open ?? 0"
          },
          "high": {
            "$expr": "$data.high-severity.high ?? 0"
          },
          "ageing": {
            "$expr": "$data.ageing.ageing ?? 0"
          },
          "threshold": {
            "$expr": "$params.age-threshold-hours"
          },
          "oldest": {
            "$expr": "round($data.oldest.oldest ?? 0, 0)"
          }
        }
      }
    },
    "search-bar": {
      "id": "search-bar",
      "type": "input.filter-bar",
      "typeVersion": "1.0.0",
      "title": "Narrow the queue",
      "config": {
        "searchChannel": "query",
        "searchPlaceholder": "Search by security name",
        "debounceMs": 250,
        "facets": [
          {
            "channel": "severity",
            "label": "Severity",
            "multi": true,
            "options": [
              {
                "value": "HIGH",
                "label": "High"
              },
              {
                "value": "MEDIUM",
                "label": "Medium"
              },
              {
                "value": "LOW",
                "label": "Low"
              }
            ]
          },
          {
            "channel": "status",
            "label": "Status",
            "multi": true,
            "options": [
              {
                "value": "OPEN",
                "label": "Open"
              },
              {
                "value": "IN_PROGRESS",
                "label": "In Progress"
              },
              {
                "value": "RESOLVED",
                "label": "Resolved"
              },
              {
                "value": "SUPPRESSED",
                "label": "Suppressed"
              }
            ]
          },
          {
            "channel": "asset-class",
            "label": "Asset Class",
            "multi": true,
            "options": [
              {
                "value": "EQUITY",
                "label": "Equity"
              },
              {
                "value": "BOND",
                "label": "Bond"
              },
              {
                "value": "FUND",
                "label": "Fund"
              },
              {
                "value": "DERIVATIVE",
                "label": "Derivative"
              }
            ]
          }
        ],
        "showClearAll": true,
        "summary": "Every figure, the trend, the rule tabs and both queues read these channels, so the page always answers one question."
      },
      "eventActions": {
        "searchChanged": "set-query",
        "facetChanged": [
          "set-severity-facet",
          "set-status-facet",
          "set-class-facet"
        ],
        "cleared": "clear-filters"
      },
      "writesTo": {
        "filters": [
          "query",
          "severity",
          "status",
          "asset-class"
        ]
      }
    },
    "kpi-open": {
      "id": "kpi-open",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Open Breaks",
      "dataSource": "open-total",
      "config": {
        "size": "md",
        "showThresholdBand": true
      },
      "bindings": {
        "value": {
          "field": "open",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Unresolved exceptions matching the current narrowing."
    },
    "kpi-high": {
      "id": "kpi-high",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "High Severity",
      "dataSource": "high-severity",
      "config": {
        "size": "md",
        "showThresholdBand": true
      },
      "bindings": {
        "value": {
          "field": "high",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Open breaks the rules classify as high severity."
    },
    "kpi-ageing": {
      "id": "kpi-ageing",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Ageing",
      "dataSource": "ageing",
      "config": {
        "size": "md",
        "showThresholdBand": true
      },
      "bindings": {
        "value": {
          "field": "ageing",
          "format": {
            "style": "integer"
          }
        }
      },
      "description": "Open breaks past the team\u2019s ageing threshold."
    },
    "kpi-oldest": {
      "id": "kpi-oldest",
      "type": "analytics.kpi-card",
      "typeVersion": "1.4.0",
      "title": "Oldest Break",
      "dataSource": "oldest",
      "config": {
        "size": "md",
        "showThresholdBand": false
      },
      "bindings": {
        "value": {
          "field": "oldest",
          "format": {
            "style": "duration"
          }
        }
      }
    },
    "severity-trend": {
      "id": "severity-trend",
      "type": "analytics.chart",
      "typeVersion": "1.0.0",
      "title": "Breaks detected, last 14 days",
      "description": "Click a segment to narrow the page to that severity.",
      "dataSource": "by-severity",
      "config": {
        "mark": "bar",
        "stacking": "stacked",
        "legend": {
          "position": "bottom"
        },
        "gridlines": true
      },
      "encodings": [
        {
          "channel": "x",
          "binding": {
            "field": "detected-at",
            "label": "Detected",
            "format": {
              "style": "date"
            }
          },
          "axis": {
            "title": "Detected",
            "gridlines": false
          }
        },
        {
          "channel": "y",
          "binding": {
            "field": "count",
            "label": "Breaks",
            "format": {
              "style": "integer"
            }
          },
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "Breaks"
          }
        },
        {
          "channel": "series",
          "binding": {
            "field": "severity",
            "label": "Severity"
          }
        }
      ],
      "eventActions": {
        "segmentActivated": "filter-by-severity"
      }
    },
    "rule-queue-table": {
      "id": "rule-queue-table",
      "type": "data.table",
      "typeVersion": "1.0.0",
      "title": "Breaks for this rule",
      "description": "One definition, rendered inside whichever rule tab is active.",
      "dataSource": "rule-queue",
      "config": {
        "density": "compact",
        "maxHeight": "420px",
        "zebra": true,
        "selectionMode": "single",
        "showRowCount": true
      },
      "bindings": {
        "columns": [
          {
            "field": "security-name",
            "label": "Security",
            "renderAs": "link"
          },
          {
            "field": "asset-class",
            "label": "Asset Class"
          },
          {
            "field": "issuer-name",
            "label": "Issuer",
            "renderAs": "link"
          },
          {
            "field": "severity",
            "label": "Severity"
          },
          {
            "field": "exception-status",
            "label": "Status"
          },
          {
            "field": "age-hours",
            "label": "Age",
            "format": {
              "style": "duration"
            },
            "align": "end"
          },
          {
            "field": "assigned-to",
            "label": "Assigned To",
            "emptyValue": "unassigned"
          },
          {
            "field": "exception-id",
            "hidden": true
          },
          {
            "field": "security-id",
            "hidden": true
          },
          {
            "field": "issuer-id",
            "hidden": true
          }
        ]
      },
      "eventActions": {
        "rowActivated": "drill-to-security",
        "selectionChanged": "set-focused-exception"
      },
      "stateOverrides": {
        "empty": {
          "title": "Nothing for this rule",
          "message": "No open break for this rule matches the current narrowing."
        },
        "partial": {
          "title": "Assignee hidden",
          "message": "You are not entitled to see who a break is assigned to. Everything else is shown."
        }
      }
    },
    "all-table": {
      "id": "all-table",
      "type": "data.table",
      "typeVersion": "1.0.0",
      "title": "Full queue",
      "dataSource": "all-exceptions",
      "config": {
        "density": "compact",
        "maxHeight": "460px",
        "zebra": true
      },
      "bindings": {
        "columns": [
          {
            "field": "security-name",
            "label": "Security",
            "renderAs": "link"
          },
          {
            "field": "rule-name",
            "label": "Rule"
          },
          {
            "field": "severity",
            "label": "Severity"
          },
          {
            "field": "exception-status",
            "label": "Status"
          },
          {
            "field": "age-hours",
            "label": "Age",
            "format": {
              "style": "duration"
            },
            "align": "end"
          },
          {
            "field": "assigned-to",
            "label": "Assigned To",
            "emptyValue": "unassigned"
          },
          {
            "field": "detected-at",
            "label": "Detected",
            "format": {
              "style": "datetime"
            }
          },
          {
            "field": "exception-id",
            "hidden": true
          },
          {
            "field": "security-id",
            "hidden": true
          }
        ]
      },
      "eventActions": {
        "rowActivated": "drill-to-security"
      },
      "stateOverrides": {
        "empty": {
          "title": "Queue is clear",
          "message": "No exception matches the current narrowing."
        },
        "partial": {
          "title": "Assignee hidden",
          "message": "You are not entitled to see who a break is assigned to."
        }
      }
    }
  },
  "layout": {
