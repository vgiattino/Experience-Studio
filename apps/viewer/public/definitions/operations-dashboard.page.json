  "actions": {
    "set-query": {
      "id": "set-query",
      "kind": "setFilter",
      "label": "Search",
      "channel": "query",
      "value": {
        "$context": "$event.value"
      }
    },
    "set-severity-facet": {
      "id": "set-severity-facet",
      "kind": "setFilter",
      "label": "Filter by severity",
      "channel": "severity",
      "value": {
        "$context": "$event.value"
      },
      "enabled": {
        "$expr": "$event.channel == 'severity'"
      }
    },
    "set-class-facet": {
      "id": "set-class-facet",
      "kind": "setFilter",
      "label": "Filter by asset class",
      "channel": "asset-class",
      "value": {
        "$context": "$event.value"
      },
      "enabled": {
        "$expr": "$event.channel == 'asset-class'"
      }
    },
    "filter-by-severity": {
      "id": "filter-by-severity",
      "kind": "setFilter",
      "label": "Filter to this severity",
      "channel": "severity",
      "value": {
        "$context": "$event.series"
      },
      "mode": "replace"
    },
    "set-focused-exception": {
      "id": "set-focused-exception",
      "kind": "setSelection",
      "channel": "focused-exception",
      "value": {
        "$context": "$event.row"
      }
    },
