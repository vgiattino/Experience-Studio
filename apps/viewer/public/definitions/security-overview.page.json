  "actions": {
    "set-field-query": {
      "id": "set-field-query",
      "kind": "setFilter",
      "label": "Search fields",
      "channel": "field-query",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace"
    },
    "set-match-facet": {
      "id": "set-match-facet",
      "kind": "setFilter",
      "label": "Filter by agreement",
      "channel": "match-status",
      "value": {
        "$context": "$event.value"
      },
      "mode": "replace",
      "enabled": {
        "$expr": "$event.channel == 'match-status'"
      }
    },
    "set-focused-field": {
      "id": "set-focused-field",
      "kind": "setSelection",
      "channel": "focused-field",
      "value": {
        "$context": "$event.source-value-id"
      }
    },
    "clear-comparison-filters": {
      "id": "clear-comparison-filters",
      "kind": "clearFilters",
      "label": "Clear",
      "channels": [
        "field-query",
        "match-status"
      ]
    },
    "refresh-page": {
      "id": "refresh-page",
      "kind": "refresh",
      "label": "Refresh",
      "icon": "refresh",
      "bypassCache": true
    },
    "drill-to-issuer": {
      "id": "drill-to-issuer",
      "kind": "drilldown",
      "label": "Open issuer",
      "entity": "parties.party",
      "key": {
        "party-id": {
          "$expr": "$data.security-header.issuer-id"
        }
      },
      "carryContext": true,
      "openIn": "self",
      "enabled": {
        "$expr": "$data.security-header.issuer-id != null"
      }
    },
    "back-to-master": {
      "id": "back-to-master",
      "kind": "navigate",
      "label": "Security master",
