{
  "schemaVersion": "1.0",
  "id": "securities.operations",
  "name": "Securities Operations",
  "description": "Operational experience for the securities master: processing health and exception remediation.",
  "icon": "securities",
  "kind": "application",
  "workspaceId": "ops-securities",
  "pages": {
    "security-master-operations": {
      "$pageRef": "security-master-operations.page.json"
    },
    "processing-detail": {
      "$pageRef": "processing-detail.page.json"
    },
    "security-master-dashboard": {
      "$pageRef": "security-master-dashboard.page.json"
    },
    "security-overview": {
      "$pageRef": "security-overview.page.json"
    },
    "party-overview": {
      "$pageRef": "party-overview.page.json"
    },
    "exception-management": {
      "$pageRef": "exception-management.page.json"
    }
  },
  "navigation": {
    "mode": "sidebar",
    "homePage": "security-master-dashboard",
    "items": [
      {
        "kind": "group",
        "id": "nav-master-group",
        "label": "Master Data",
        "icon": "database",
        "children": [
          {
            "kind": "page",
            "id": "nav-security-master",
            "label": "Security Master Dashboard",
            "icon": "dashboard",
            "page": "security-master-dashboard"
          },
          {
            "kind": "page",
            "id": "nav-exceptions",
            "label": "Exception Management",
            "icon": "alert",
            "page": "exception-management",
            "badge": {
              "source": "nav-attention-count",
              "field": "attention-count",
              "emphasis": "negative"
            }
          }
        ]
      },
      {
        "kind": "group",
        "id": "nav-operations-group",
        "label": "Operations",
        "icon": "dashboard",
        "children": [
          {
            "kind": "page",
            "id": "nav-operations",
            "label": "Security Master",
            "icon": "dashboard",
            "page": "security-master-operations"
          },
          {
            "kind": "page",
            "id": "nav-processing",
            "label": "File Processing",
            "icon": "pipeline",
            "page": "processing-detail",
            "badge": {
              "source": "nav-attention-count",
              "field": "attention-count",
              "emphasis": "warning"
            }
          }
        ]
      },
      {
        "kind": "divider",
        "id": "nav-divider"
      },
      {
        "kind": "external",
        "id": "nav-runbook",
        "label": "Architecture docs",
        "icon": "book",
        "urlTemplate": "https://github.com/vgiattino/Experience-Studio/tree/main/architecture"
      }
    ],
    "drilldownTargets": {
      "processing.file-load": {
        "page": "processing-detail",
        "openIn": "self"
      },
      "securities.security": {
        "page": "security-overview",
        "openIn": "self"
      },
      "parties.party": {
        "page": "party-overview",
        "openIn": "self"
      },
      "dq.exception": {
        "page": "exception-management",
        "openIn": "self"
      }
    }
  },
  "parameters": {
    "as-of": {
      "label": "As Of",
      "dataType": "date",
      "default": {
        "$expr": "today()"
      },
      "required": true,
      "exposedInShell": false,
      "persist": "session"
    }
  },
  "dataSources": {
    "nav-attention-count": {
      "id": "nav-attention-count",
      "name": "Loads Needing Attention",
      "description": "Drives the live badge beside the File Processing nav item.",
      "entity": "processing.file-load",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "late-file-count",
            "aggregation": "count",
            "alias": "attention-count"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "load-status",
            "operator": "in",
            "value": [
              "LATE",
              "FAILED"
            ]
          },
          {
            "target": "business-date",
            "operator": "onOrAfterToday"
          }
        ]
      },
      "loadPolicy": "eager",
      "cacheTtlHintSeconds": 120,
      "expectedCostClass": "low"
    }
  },
  "security": {
    "intendedAudience": "Securities operations team and data stewards.",
    "requiredCapabilities": [
      "experience.view"
    ],
    "workspaceScope": "tenant",
    "deniedDataPolicy": "showDeniedState",
    "exportPolicy": {
      "allowed": true,
      "formats": [
        "csv"
      ],
      "maxRows": 50000,
      "requiresReason": true,
      "watermark": true
    },
    "auditProfile": "standard",
    "sharingPolicy": {
      "allowCopy": true,
      "allowTemplate": true,
      "allowCrossTenantExemplar": false
    }
  },
  "presentation": {
    "themeRef": "opus.default",
    "density": "comfortable",
    "showShellHeader": true
  },
  "localization": {
    "defaultLocale": "en-GB",
    "supportedLocales": [
      "en-GB",
      "en-US",
      "de-DE"
    ]
  },
  "environments": [
    "dev"
  ],
  "version": {
    "schemaVersion": "1.0",
    "artifactVersion": 1,
    "lifecycleState": "published",
    "immutable": true,
    "pins": {
      "catalogVersion": 9,
      "registryVersion": "1.1.0"
    },
    "provenance": {
      "origin": "human",
      "actorId": "platform-team@demo-tenant",
      "createdAt": "2026-08-04T09:00:00Z",
      "editSummary": {
        "summary": "Added the four EDM business templates and the drill-down graph that links them: the security master dashboard drills to an instrument, an instrument to its issuer, and any break to the remediation workbench."
      }
    },
    "validation": {
      "status": "valid",
      "stagesPassed": [
        "structural"
      ],
      "validatedAt": "2026-08-04T09:00:00Z"
    },
    "governance": {
      "publishedBy": "platform-team@demo-tenant",
      "publishedAt": "2026-08-04T09:00:00Z",
      "publishedEnvironments": [
        "dev"
      ]
    },
    "audit": {
      "createdBy": "platform-team@demo-tenant",
      "createdAt": "2026-08-04T09:00:00Z"
    }
  },
  "tags": [
    "edm",
    "m1-reference",
    "operations",
    "securities",
    "templates"
  ]
}
