{
  "schemaVersion": "1.0",
  "id": "securities.operations",
  "name": "Securities Operations",
  "description": "Operational experience for the securities master: processing health, exception remediation, and security detail.",
  "icon": "securities",
  "kind": "application",
  "workspaceId": "ops-securities",
  "pages": {
    "security-master-operations": {
      "$pageRef": "security-master-dashboard.page.json"
    },
    "security-detail": {
      "$pageRef": "security-detail.page.json"
    },
    "processing-detail": {
      "$pageRef": "processing-detail.page.json"
    },
    "security-search": {
      "$pageRef": "security-search.page.json"
    }
  },
  "navigation": {
    "mode": "sidebar",
    "homePage": "security-master-operations",
    "showSearch": {
      "enabled": true,
      "entity": "securities.security",
      "placeholder": "Search by name, ISIN or SEDOL"
    },
    "items": [
      {
        "kind": "page",
        "id": "nav-operations",
        "label": "Operations",
        "icon": "dashboard",
        "page": "security-master-operations"
      },
      {
        "kind": "group",
        "id": "nav-securities",
        "label": "Securities",
        "icon": "securities",
        "children": [
          {
            "kind": "page",
            "id": "nav-search",
            "label": "Search",
            "icon": "search",
            "page": "security-search"
          }
        ]
      },
      {
        "kind": "page",
        "id": "nav-processing",
        "label": "Processing",
        "icon": "pipeline",
        "page": "processing-detail",
        "badge": {
          "source": "nav-late-count",
          "field": "late-count",
          "emphasis": "warning"
        }
      },
      {
        "kind": "divider",
        "id": "nav-div-1"
      },
      {
        "kind": "external",
        "id": "nav-help",
        "label": "Operations Runbook",
        "icon": "book",
        "urlTemplate": "https://intranet.example.com/runbooks/securities-ops"
      }
    ],
    "drilldownTargets": {
      "securities.security": {
        "page": "security-detail",
        "openIn": "self"
      },
      "dq.exception": {
        "page": "security-detail",
        "tab": "exceptions",
        "openIn": "drawer"
      },
      "processing.file-load": {
        "page": "processing-detail",
        "openIn": "self"
      }
    }
  },
  "parameters": {
    "as-of": {
      "label": "As Of",
      "dataType": "date",
      "default": {
        "$expr": "today()"
      },
      "required": true,
      "exposedInShell": true,
      "persist": "session"
    },
    "base-currency": {
      "label": "Base Currency",
      "dataType": "string",
      "default": "GBP",
      "boundToAttribute": "securities.security.currency",
      "exposedInShell": true,
      "persist": "user"
    }
  },
  "dataSources": {
    "nav-late-count": {
      "id": "nav-late-count",
      "name": "Late File Count for Navigation Badge",
      "entity": "processing.file-load",
      "kind": "aggregate",
      "select": {
        "measures": [
          {
            "measure": "late-file-count",
            "aggregation": "count",
            "alias": "late-count"
          }
        ]
      },
      "filter": {
        "all": [
          {
            "target": "business-date",
            "operator": "eq",
            "value": {
              "$param": "as-of"
            }
          },
          {
            "target": "load-status",
            "operator": "eq",
            "value": "LATE"
          }
        ]
      },
      "refresh": {
        "mode": "interval",
        "intervalSeconds": 300
      },
      "loadPolicy": "eager",
      "expectedCostClass": "low"
    }
  },
  "actions": {
    "reset-context": {
      "id": "reset-context",
      "kind": "setParameter",
      "label": "Reset to Today",
      "parameter": "as-of",
      "value": {
        "$expr": "today()"
      },
      "updateUrl": true
    }
  },
  "security": {
    "intendedAudience": "Securities operations team and data stewards.",
    "requiredRoles": [
      "viewer",
      "author"
    ],
    "requiredCapabilities": [
      "experience.view"
    ],
    "workspaceScope": "tenant",
    "deniedDataPolicy": "showDeniedState",
    "exportPolicy": {
      "allowed": true,
      "formats": [
        "csv",
        "xlsx"
      ],
      "maxRows": 50000,
      "requiresReason": true,
      "watermark": true
    },
    "auditProfile": "standard",
    "sharingPolicy": {
      "allowCopy": true,
      "allowTemplate": true,
      "allowCrossTenantExemplar": false
    }
  },
  "aiContext": {
    "extends": "product",
    "terminology": [
      {
        "term": "Late file",
        "means": "A vendor file whose expected arrival time has passed and which has not been received. Lateness is measured against the vendor contract, not against the load window.",
        "notToBeConfusedWith": "A failed file, which arrived and could not be processed."
      },
      {
        "term": "New security",
        "means": "An instrument first seen in the current business date, whether or not it has been mastered yet."
      }
    ],
    "instructions": [
      "Figures on this dashboard are as of the selected business date, never \"now\". Do not add a component that reads current time.",
      "Prefer the vendor contract as the source for expectation, not the observed history."
    ],
    "hints": {
      "whenToUse": "Questions about today\u2019s processing: what arrived, what is late, what failed, what is queued for review.",
      "whenNotToUse": "Questions about one instrument\u2019s golden record \u2014 that is Security Overview."
    }
  },
  "documentation": {
    "purpose": "The page a data steward opens first: what the overnight run did, what it did not do, and what is waiting for a person.",
    "audience": "Data stewards and operations leads on the securities desk.",
    "notes": "Row counts are estimates read from partition metadata, so a figure moving by a few rows between refreshes is expected and is not drift."
  },
  "tests": {
    "late-files-honours-as-of": {
      "name": "Late file count follows the selected business date",
      "origin": "authored",
      "covers": {
        "pages": [
          "security-master-operations"
        ],
        "entities": [
          "processing.file-load"
        ]
      },
      "given": "A business date on which two vendor files were late.",
      "expect": "The Late Files KPI reads 2, and changing the date changes the figure rather than leaving it at today\u2019s value."
    },
    "drilldown-carries-the-security": {
      "name": "Drill-down carries the selected security to the detail page",
      "origin": "authored",
      "covers": {
        "pages": [
          "security-master-operations",
          "security-detail"
        ]
      },
      "expect": "Selecting a row opens Security Detail for that instrument, with the business date preserved."
    },
    "nav-count-matches-kpi": {
      "name": "The navigation badge agrees with the KPI it summarises",
      "origin": "generated",
      "covers": {
        "dataSources": [
          "nav-late-count"
        ]
      },
      "expect": "The late-count badge in navigation equals the Late Files KPI on the dashboard."
    }
  },
  "presentation": {
    "themeRef": "opus.default",
    "density": "comfortable",
    "showShellHeader": true
  },
  "localization": {
    "defaultLocale": "en-GB",
    "supportedLocales": [
      "en-GB",
      "en-US",
      "de-DE"
    ],
    "stringTableRef": "securities.operations.strings"
  },
  "environments": [
    "dev",
    "uat",
    "production"
  ],
  "version": {
    "schemaVersion": "1.0",
    "artifactVersion": 22,
    "lifecycleState": "published",
    "immutable": true,
    "pins": {
      "catalogVersion": 7,
      "registryVersion": "3.2.0"
    },
    "lineage": {
      "basedOnVersion": 21,
      "supersedes": 21
    },
    "provenance": {
      "origin": "human",
      "actorId": "ops-lead@demo-tenant",
      "createdAt": "2026-08-03T14:10:00Z",
      "editSummary": {
        "patchOperationCount": 3,
        "humanPatchOperations": 3,
        "aiPatchOperations": 0,
        "summary": "Added the processing navigation badge and the runbook link."
      }
    },
    "validation": {
      "status": "valid",
      "stagesPassed": [
        "structural",
        "component",
        "semantic",
        "binding",
        "entitlement",
        "cost",
        "layout",
        "accessibility"
      ],
      "validatedAt": "2026-08-03T14:12:00Z"
